# ─────────────────────────────────────────────────────────────────────────────
# Invroot — production environment template
#
# Copy to .env on the production host and fill in the blanks. NEVER commit the
# filled-in file: .gitignore covers .env, and this template deliberately holds
# no secrets.
#
# Every value marked ⚠️ must differ from the development one. The development
# values are in a public git commit and must be treated as compromised.
# ─────────────────────────────────────────────────────────────────────────────

# ── App / domain ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Public site. Used for Stripe checkout return URLs, email verification links,
# password-reset links and public payment links (/pay/:token). Must be the real
# HTTPS origin — anything else sends paying customers to a dead address.
FRONTEND_URL=https://invroot.com

# Where the API itself is reachable.
APP_URL=https://invroot.com
API_URL=https://invroot.com

# Browser origins allowed to call the API (comma-separated). Add the www host
# only if you actually serve it rather than redirecting.
CORS_ORIGINS=https://invroot.com,https://www.invroot.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=invroot
DB_USER=            # ⚠️ not root — a dedicated user scoped to this database
DB_PASS=            # ⚠️ new value

# ── Auth ─────────────────────────────────────────────────────────────────────
# ⚠️ Must be a fresh long random string. The development secret is public, and
# anyone holding it can mint valid tokens for any tenant.
# Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_TLS=true
EMAIL_USER=support@invroot.com
EMAIL_PASS=            # ⚠️ new value
EMAIL_FROM=support@invroot.com
EMAIL_NAME=Invroot

# Where Enterprise enquiries are delivered.
SALES_INBOX=info@trasealla.com,support@invroot.com

# ── Stripe ───────────────────────────────────────────────────────────────────
# This Stripe account is shared with another product. The namespace keeps
# Invroot's objects separate and makes the webhook ignore events that aren't
# ours — do not change it once subscriptions exist.
STRIPE_APP_NAMESPACE=invroot
STRIPE_API_VERSION=2024-06-20

# Live keys (sk_live_…). Keep test and live strictly separate.
STRIPE_SECRET_KEY=
# From the live-mode webhook endpoint pointing at
#   https://invroot.com/api/stripe/webhook
# subscribed to: customer.subscription.created / .updated / .deleted,
#                invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Live price for Starter (AED 69/month). Create it in the Stripe dashboard —
# scripts/stripe-setup.js deliberately refuses to create live-mode objects.
STRIPE_PRICE_STARTER=
# Enterprise is sales-led and has no Stripe price.

# ── Platform admin ───────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@invroot.com
SUPER_ADMIN_PASSWORD=       # ⚠️ new value; then run: npm run create-super-admin
SUPER_ADMIN_NAME=Platform Administrator

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── File storage (S3) ────────────────────────────────
# Production must use s3: a container's local disk is wiped on every deploy,
# so anything written to uploads/ disappears with the old container.
STORAGE_DRIVER=s3
S3_BUCKET=invroot-uploads-prod          # your bucket name
S3_REGION=us-east-2
AWS_ACCESS_KEY_ID=                      # ⚠️ IAM user key — never commit
AWS_SECRET_ACCESS_KEY=                  # ⚠️ IAM user secret — never commit
# Seconds a signed read URL stays valid. Keep it short: these URLs get pasted
# into chats and would otherwise outlive the access that produced them.
S3_SIGNED_URL_TTL=300

# ── Sessions ─────────────────────────────────────────
JWT_EXPIRES=15m               # access token; keep it short
SESSION_REFRESH_DAYS=30       # rolling refresh window
SESSION_ABSOLUTE_DAYS=90      # hard cap; re-authentication required past this
