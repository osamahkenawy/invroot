{
  "name": "invroot-backend",
  "version": "1.0.0",
  "description": "Invroot \u2013 Billing Simplified. Multi-tenant invoicing & billing backend.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/run.js",
    "seed": "node src/seeds/index.js",
    "create-super-admin": "node scripts/create-super-admin.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "stripe:setup": "node scripts/stripe-setup.js",
    "webhook:test": "node scripts/webhook-test.js",
    "test:storage": "node scripts/storage-test.mjs",
    "test:brand": "node scripts/brand-asset-test.mjs",
    "test:profile": "node scripts/profile-avatar-test.mjs",
    "test:edge": "node scripts/profile-edge-test.mjs",
    "test:all": "npm test && npm run test:storage && npm run test:brand && npm run test:profile && npm run test:edge && npm run test:pricing && npm run test:email && npm run test:refresh && npm run test:coupon && npm run test:billable && npm run test:banking && npm run test:import && npm run test:adversarial",
    "test:pricing": "node scripts/signup-pricing-test.mjs",
    "test:email": "node scripts/email-render-test.mjs",
    "test:refresh": "node scripts/refresh-token-test.mjs",
    "test:coupon": "node scripts/coupon-test.mjs",
    "test:billable": "node scripts/billable-work-test.mjs",
    "test:logo-survival": "node scripts/logo-survival-test.mjs",
    "test:s3": "node scripts/s3-endtoend-test.mjs",
    "test:banking": "node scripts/bank-reconciliation-test.mjs",
    "test:import": "node scripts/invoice-import-test.mjs",
    "test:adversarial": "node scripts/adversarial-test.mjs",
    "clean:fixtures": "node scripts/clean-fixtures.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "puppeteer": "^22.9.0",
    "sharp": "^0.33.4",
    "stripe": "^15.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
